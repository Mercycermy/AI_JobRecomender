# Runtime
APP_ENV=development
FLASK_SECRET_KEY=
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Frontend/API boundary
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_CONTENT_LENGTH=5242880

# Optional API key protection for write/admin-style endpoints.
# Set API_KEY to protect Telegram ingest/refresh routes.
# Set REQUIRE_API_KEY=1 to require it for every non-OPTIONS API route.
API_KEY=
REQUIRE_API_KEY=0

# Rate limits are per process and per endpoint.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=30

# SQLite/data paths
DATA_DIR=data
RECOMMENDER_DB_PATH=data/db.sqlite3
QUIZ_DB_PATH=data/jobs.db
JOBS_INDEX_PATH=data/jobs_faiss.index
JOBS_ID_MAP_PATH=data/jobs_id_map.json
TELEGRAM_JOBS_FEED_PATH=data/telegram_jobs.json
TAXONOMY_PATH=data/skills_taxonomy.json
LEARNING_RESOURCES_PATH=data/learning_resources.json
RUN_MIGRATIONS_ON_STARTUP=1

# AI providers
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model for local FAISS artifacts
EMBEDDING_MODEL=all-MiniLM-L6-v2
